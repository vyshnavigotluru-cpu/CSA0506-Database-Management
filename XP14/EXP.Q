DROP DATABASE IF EXISTS LoopDB;
CREATE DATABASE LoopDB;
USE LoopDB;
DELIMITER $$
CREATE PROCEDURE WhileDemo()
BEGIN
DECLARE i INT DEFAULT 1;
WHILE i<=5 DO
SELECT i;
SET i=i+1;
END WHILE;
END $$
CREATE PROCEDURE RepeatDemo()
BEGIN
DECLARE j INT DEFAULT 1;
REPEAT
SELECT j;
SET j=j+1;
UNTIL j>5
END REPEAT;
END $$
DELIMITER ;
CALL WhileDemo();
CALL RepeatDemo();
